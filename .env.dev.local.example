# Template for .env.dev.local — real device config for the DEV stack (`make dev-up`).
# Copy to .env.dev.local (gitignored) and fill in. Optional: without it, the dev stack
# just uses broadcast auto-discovery on your LAN. Use this when your devices need
# TP-Link account auth (KLAP devices) and/or are cross-subnet (explicit hosts).

# TP-Link account — required for newer cloud-auth (KLAP) devices
KASA_COLLECTOR_TPLINK_USERNAME=you@example.com
KASA_COLLECTOR_TPLINK_PASSWORD=your-tplink-password

# Explicit device hosts (comma-separated IPs/hostnames). Set auto-discovery off if
# your devices are cross-subnet (broadcast won't reach them).
KASA_COLLECTOR_ENABLE_AUTO_DISCOVERY=False
KASA_COLLECTOR_DEVICE_HOSTS=kasa-device-1.example.com,kasa-device-2.example.com
