# kasa-collector environment template. Copy to .env.dev / .env.prod and fill in.
# .env.dev and .env.prod are gitignored; ONLY this template is committed.
#
#   docker compose --env-file .env.<env> up -d
#
# The first block is read by COMPOSE ITSELF (image tag, profiles, ports); everything
# below it is the collector's own configuration, passed into the container.

# --- compose interpolation -------------------------------------------------
# Which image to run. The app image is always PINNED — never :latest.
REGISTRY=registry.example.com:5000
# An IMMUTABLE tag, never :dev/:latest. dev -> sha-<commit>, written here by `make dev-deploy`
# (roll back with `make dev-pin TAG=…`) · prod -> the released version, e.g. 2026.10.1
TAG=sha-<commit>
ENV_FILE=.env.dev            # this file; compose passes it into the container
# Which services run. There is ONE compose.yml and the STACK is a profile, so this
# is required — every service sits behind a profile and an unset value starts nothing.
#   collector           prod: the collector alone, against YOUR InfluxDB
#   collector,bundled   dev:  + bundled InfluxDB & Grafana  (matches ENV_FILE above)
#   demo                fake devices + bundled stack, no hardware
COMPOSE_PROFILES=collector,bundled
# Ports for the bundled stack. Sibling apps share the box, so 3000 is often taken.
# INFLUX_PORT=8086
# GRAFANA_PORT=3000
# OUTPUT_DIR=/mnt/docker/kasa-collector/output

# --- collector configuration -----------------------------------------------
TZ=America/Chicago

# InfluxDB — where energy metrics are written
KASA_COLLECTOR_INFLUXDB_URL=http://influxdb.example.com:8086
KASA_COLLECTOR_INFLUXDB_ORG=your-org
KASA_COLLECTOR_INFLUXDB_BUCKET=kasa
KASA_COLLECTOR_INFLUXDB_TOKEN=your-influxdb-token

# TP-Link Kasa account — only needed for newer cloud-auth (KLAP) devices
KASA_COLLECTOR_TPLINK_USERNAME=you@example.com
KASA_COLLECTOR_TPLINK_PASSWORD=your-tplink-password

# Discovery
KASA_COLLECTOR_ENABLE_AUTO_DISCOVERY=True
KASA_COLLECTOR_DEVICE_DISCOVERY_INTERVAL=300
KASA_COLLECTOR_DISCOVERY_PACKETS=3
KASA_COLLECTOR_DISCOVERY_TIMEOUT=5
# Consecutive missed discovery rounds before a discovered device is pruned.
# Discovery is a lossy UDP broadcast -- a healthy device can miss a round.
KASA_COLLECTOR_DISCOVERY_MISS_THRESHOLD=3
# Seconds before the first re-discovery pass after startup, so a device that
# missed the startup broadcast is picked up without waiting a full interval.
KASA_COLLECTOR_DISCOVERY_CATCH_UP_DELAY=30
KASA_COLLECTOR_KEEP_MISSING_DEVICES=True
# Optional: explicit device hostnames/IPs (comma-separated) for manual/cross-subnet devices
# KASA_COLLECTOR_DEVICE_HOSTS=kasa-device-1.example.com,kasa-device-2.example.com

# Data collection
KASA_COLLECTOR_DATA_FETCH_INTERVAL=15
KASA_COLLECTOR_SYSINFO_FETCH_INTERVAL=60
KASA_COLLECTOR_FETCH_MAX_RETRIES=5
KASA_COLLECTOR_FETCH_RETRY_DELAY=1

# Output / health
KASA_COLLECTOR_WRITE_TO_FILE=True
KASA_COLLECTOR_OUTPUT_DIR=output
KASA_COLLECTOR_HEALTH_CHECK_MAX_AGE=120

# Log levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
KASA_COLLECTOR_LOG_LEVEL_KASA_COLLECTOR=INFO
KASA_COLLECTOR_LOG_LEVEL_KASA_API=INFO
KASA_COLLECTOR_LOG_LEVEL_INFLUXDB_STORAGE=INFO
