# Self-contained DEMO / quickstart stack (compose.demo.yaml). Unlike .env.dev/.env.prod
# these are NOT real secrets — they configure a throwaway, local-only InfluxDB + Grafana
# that are created fresh on `make demo-up`. Safe to commit so `docker compose up` works
# out of the box. Do NOT reuse these values anywhere real.

TZ=America/Chicago

# --- Bundled InfluxDB (demo) ---
INFLUX_ORG=kasa
INFLUX_BUCKET=kasa
INFLUX_TOKEN=kasa-collector-demo-token-not-secret
INFLUX_USER=kasa
INFLUX_PASSWORD=kasademo-password

# --- Bundled Grafana (demo) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Published host ports (override if 3000/8086 are taken on your host).
# If you change INFLUX_PORT, also update KASA_COLLECTOR_INFLUXDB_URL below.
GRAFANA_PORT=3000
INFLUX_PORT=8086

# --- Collector -> bundled InfluxDB ---
# The collector uses host networking (device discovery), so it reaches the bundled
# InfluxDB via the published port on localhost.
KASA_COLLECTOR_INFLUXDB_URL=http://localhost:8086
KASA_COLLECTOR_INFLUXDB_ORG=kasa
KASA_COLLECTOR_INFLUXDB_BUCKET=kasa
KASA_COLLECTOR_INFLUXDB_TOKEN=kasa-collector-demo-token-not-secret
KASA_COLLECTOR_ENABLE_AUTO_DISCOVERY=True
KASA_COLLECTOR_DEVICE_DISCOVERY_INTERVAL=300
KASA_COLLECTOR_DATA_FETCH_INTERVAL=15
KASA_COLLECTOR_SYSINFO_FETCH_INTERVAL=60
KASA_COLLECTOR_WRITE_TO_FILE=True
KASA_COLLECTOR_OUTPUT_DIR=output
KASA_COLLECTOR_HEALTH_CHECK_MAX_AGE=120
KASA_COLLECTOR_LOG_LEVEL_KASA_COLLECTOR=INFO
KASA_COLLECTOR_LOG_LEVEL_KASA_API=INFO
KASA_COLLECTOR_LOG_LEVEL_INFLUXDB_STORAGE=INFO
